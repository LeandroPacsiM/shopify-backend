{
	"info": {
		"name": "Plataforma Tiendas (local)",
		"description": "Auth con 2FA + superficies por tienda. Flujo demo: Auth > Storefront > Checkout > Admin > Facturación. Ver diagramas/01, diagramas/10 y docs/10-requerimientos.md. Códigos de email/reset llegan por correo (modo log en consola sin llave Resend).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "tiendaSlug",
			"value": "tienda-demo"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "carritoToken",
			"value": "",
			"description": "Se copia del campo token de 'ver carrito'"
		},
		{
			"key": "idempotencia",
			"value": "demo-0001",
			"description": "Rotar por cada reembolso nuevo; repetir para reintentar"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "registro administrativo (staff, sin permisos)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/registro-administrativo",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"staff1@example.com\",\"password\":\"Secreta123\",\"nombre\":\"Staff\"}"
						}
					}
				},
				{
					"name": "email solicitar (reenvía código)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/email/solicitar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"cliente1@example.com\"}"
						}
					}
				},
				{
					"name": "email confirmar (código del correo)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/email/confirmar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"token\":\"PEGAR-CODIGO\"}"
						}
					}
				},
				{
					"name": "login (challenge)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/login",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"cliente1@example.com\",\"password\":\"Secreta123\"}"
						}
					}
				},
				{
					"name": "login totp pre-2FA (JWT limitado mfa=pendiente)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/login/totp",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"staff1@example.com\",\"password\":\"Secreta123\"}"
						}
					}
				},
				{
					"name": "crear tienda trial (JWT limitado, queda STORE_OWNER)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/tiendas",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"nombre\":\"Mi Tienda\",\"slug\":\"mi-tienda\"}"
						}
					}
				},
				{
					"name": "escribir con limitada = 403 (deny-list ADR-017)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/api/admin/productos",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "X-Tienda-Slug",
								"value": "{{tiendaSlug}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"titulo\":\"Trial\",\"slug\":\"trial\"}"
						}
					}
				},
				{
					"name": "totp iniciar (QR)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/totp/iniciar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"cliente1@example.com\",\"password\":\"Secreta123\"}"
						}
					}
				},
				{
					"name": "totp confirmar (código app + backup codes)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/totp/confirmar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"cliente1@example.com\",\"password\":\"Secreta123\",\"codigo\":\"123456\"}"
						}
					}
				},
				{
					"name": "login totp con codigo (JWT completo mfa=completa)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/login/totp",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"cliente1@example.com\",\"password\":\"Secreta123\",\"codigo\":\"123456\"}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var j = pm.response.json();",
									"pm.collectionVariables.set('accessToken', j.accessToken);"
								]
							}
						}
					]
				},
				{
					"name": "refresh (usa cookie, guarda accessToken)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/refresh"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var j = pm.response.json();",
									"if (j.accessToken) { pm.collectionVariables.set('accessToken', j.accessToken); }"
								]
							}
						}
					]
				},
				{
					"name": "logout",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/logout"
					}
				},
				{
					"name": "password solicitar (reset)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/password/solicitar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"cliente1@example.com\"}"
						}
					}
				},
				{
					"name": "password confirmar (código + nueva)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/password/confirmar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"token\":\"PEGAR-CODIGO\",\"password\":\"NuevaClave123\"}"
						}
					}
				}
			]
		},
		{
			"name": "Auth CUSTOMER",
			"item": [
				{
					"name": "solicitar codigo (email)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/cliente/solicitar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"tiendaSlug\":\"{{tiendaSlug}}\",\"email\":\"customer1@example.com\"}"
						}
					}
				},
				{
					"name": "verificar codigo (crea perfil + JWT)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/cliente/verificar",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"tiendaSlug\":\"{{tiendaSlug}}\",\"email\":\"customer1@example.com\",\"codigo\":\"123456\"}"
						}
					}
				},
				{
					"name": "refresh customer (cookie refresh_customer)",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/cliente/refresh"
					}
				},
				{
					"name": "logout customer",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/auth/cliente/logout"
					}
				}
			]
		},
		{
			"name": "Storefront",
			"item": [
				{
					"name": "productos",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/storefront/{{tiendaSlug}}/productos?q=",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "X-Tienda-Slug",
								"value": "{{tiendaSlug}}"
							}
						]
					}
				},
				{
					"name": "producto por slug",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/storefront/{{tiendaSlug}}/productos/:slug",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "X-Tienda-Slug",
								"value": "{{tiendaSlug}}"
							}
						]
					}
				},
				{
